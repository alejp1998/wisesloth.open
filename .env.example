# Generate secrets with python3 scripts/setup.py; do not commit .env.
APP_URL=http://localhost:8080
PORT=8080
BIND_ADDRESS=127.0.0.1
TRUST_PROXY=0
SESSION_SECRET=
KEY_ENCRYPTION_SECRET=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ALLOW_REGISTRATION=false
# General HTTP limit per signed-in account (or IP for guests); 0 disables it.
HTTP_RATE_LIMIT_PER_15_MIN=500

# Host key is optional when users bring their own key in Settings.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=openai/gpt-6-luna
# Optional OpenAI-compatible endpoint, trusted host configuration only.
LLM_API_BASE=
LLM_MAX_OUTPUT_TOKENS=16384
LLM_USE_CATALOG_PRICES=true
# Fallback estimates for models absent from LiteLLM's price catalog.
# These are illustrative rates; replace them with your provider's rates.
LLM_INPUT_USD_PER_MILLION=0.1
LLM_OUTPUT_USD_PER_MILLION=0.5
# Conservative estimate recorded for a transport failure with unknown usage.
UNCERTAIN_REQUEST_COST_USD=1
# Seeds the instance limit only once. Change it later in admin Settings.
# Blank is unlimited; zero disables AI for everyone.
INSTANCE_WEEKLY_BUDGET_USD=
