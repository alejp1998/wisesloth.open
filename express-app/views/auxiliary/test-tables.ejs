
<p class="title is-4 has-text-centered">
  <span lang="en">Scoreboard</span>
  <span lang="es">Puntuaciones</span>
</p>
<div class="tabs is-boxed is-medium is-centered is-fullwidth">
  <ul>
    <li id="tab-toggle-latestTab" class="tab <%= test.bestResults.length > 0 ? "" : "is-active" %>">
      <a>
        <span class="icon is-small"><i class="fas fa-clock" aria-hidden="true"></i></span>
        <span>
          <p class="is-size-6">
            <span lang="en">Latest</span>
            <span lang="es">Últimos</span>
          </p>
        </span>
      </a>
    </li>
    <li id="tab-toggle-bestTab" class="tab <%= test.bestResults.length > 0 ? "is-active" : "" %>">
      <a>
        <span class="icon is-small"><i class="fas fa-trophy" aria-hidden="true"></i></span>
        <span>
          <p class="is-size-6">
            <span lang="en">Best</span>
            <span lang="es">Mejores</span>
          </p>
        </span>
      </a>
    </li>
    <li id="tab-toggle-myTab" class="tab">
      <a>
        <span class="icon is-small"><i class="fas fa-user-astronaut" aria-hidden="true"></i></span>
        <span>
          <p class="is-size-6">
            <span lang="en">Mine</span>
            <span lang="es">Míos</span>
          </p>
        </span>
      </a>
    </li>
  </ul>
</div>

<% function correctPercentage(score,nQuestions) { return Math.round((score/nQuestions)*100); } %>
<% function getWeigthedScore(nSeconds,nQuestions,score) { return 100000*(score/nQuestions) + 50*nQuestions - nSeconds; } %>
<div id="tab-content-latestTab" class="tab-content <%= test.bestResults.length > 0 ? "is-hidden" : "" %>">
  <% if (test.latestResults.length > 0) { %>
  <div class="table-container">
    <table class="table is-fullwidth is-hoverable">
      <thead>
        <tr>
          <th class="test-tables-header sortable descending" data-type="text"><span lang="en">User</span><span lang="es">Usuario</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
          <th class="test-tables-header has-text-right sortable descending" data-type="date" style="color: var(--link-color);"><span lang="en">Date</span><span lang="es">Fecha</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
          <th class="test-tables-header has-text-right sortable descending" data-type="number"><span lang="en">Duration</span><span lang="es">Duración</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
          <th class="test-tables-header has-text-right sortable descending" data-type="number"><span lang="en">Score</span><span lang="es">Puntuación</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
        </tr>
      </thead>
      <tbody>
        <% test.latestResults.forEach(result => { %>
        <tr class="is-clickable" data-href="/results/<%= result.id %>">
          <td class="test-tables-text" data-value="<%= result.examinee ? result.examinee.username : "ZZZZZZZZZ" %>">
            <% if (result.examinee) { %>
              <% if (session.user && result.examinee.username === session.user.username) { %>
              <a href="/users/<%= result.examinee.username %>">
                <span class="icon has-text-primary"><i class="fas fa-user-astronaut"></i></span>
                <span class="has-text-primary"><%= result.examinee.username %></span>
              </a>
              <% } else { %>
              <a href="/users/<%= result.examinee.username %>"><%= result.examinee.username %></a>
              <% } %>
            <% } else { %>
            <span class="icon"></span>
            <span lang="en">unknown</span>
            <span lang="es">desconocido</span>
            <% } %>
          </td>
          <td class="test-tables-text has-text-right" data-value="<%= result.updatedAt %>"><%= formatTimeAgo(result.updatedAt, lang) %></td>
          <% const minutes = Math.floor(result.nSeconds / 60); %>
          <% const seconds = Math.floor(result.nSeconds) % 60; %>
          <% const formattedTime = `${minutes ? minutes.toString()+"m" : ""} ${seconds.toString()}s`; %>
          <td class="test-tables-text has-text-right" data-value="<%= result.nSeconds %>"><%= formattedTime %></td>
          <% var correctPercentageVal = correctPercentage(result.score,result.nQuestions) %>
          <td class="test-tables-text has-text-right" data-value="<%= getWeigthedScore(result.nSeconds, result.nQuestions, result.score) %>">
            <%= result.score %>/<%= result.nQuestions %> (<%= correctPercentageVal %>%)
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="has-text-centered">
    <span lang="en">No results for this test yet.</span>
    <span lang="es">No hay resultados para este test aún.</span>
  </p>
  <% } %>
</div>

<div id="tab-content-bestTab" class="tab-content <%= test.bestResults.length > 0 ? "" : "is-hidden" %>">
  <% if (test.bestResults.length > 0) { %>
  <div class="table-container">
    <table class="table is-fullwidth is-hoverable">
      <thead>
        <tr>
          <th class="test-tables-header sortable descending" data-type="text"><span lang="en">User</span><span lang="es">Usuario</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
          <th class="test-tables-header has-text-right sortable descending" data-type="date"><span lang="en">Date</span><span lang="es">Fecha</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
          <th class="test-tables-header has-text-right sortable descending" data-type="number"><span lang="en">Duration</span><span lang="es">Duración</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
          <th class="test-tables-header has-text-right sortable descending" data-type="number" style="color: var(--link-color);"><span lang="en">Score</span><span lang="es">Puntuación</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
        </tr>
      </thead>
      <tbody>
        <% let n = 0; %>
        <% let styleStr = "color: var(--bulma-grey);"; %>
        <% test.bestResults.forEach(result => { %>
        <% n += 1; %>
        <% if (n === 1) { %>
        <% var styleStr = "color: var(--gold-color);"; %>
        <% } else if (n === 2) { %>
        <% var styleStr = "color: var(--silver-color);"; %>
        <% } else if (n === 3) { %>
        <% var styleStr = "color: var(--bronze-color);"; %>
        <% } else { %>
        <% var styleStr = "color: var(--bulma-grey);"; %>
        <% } %>
        <tr class="is-clickable" data-href="/results/<%= result.id %>">
          <td class="test-tables-text" data-value="<%= result.examinee ? result.examinee.username : "ZZZZZZZZZ" %>">
            <% if (result.examinee) { %>
            <a href="/users/<%= result.examinee.username %>">
            <% if (n <= 3) { %>
            <span class="icon"><i class="fas fa-medal" style="<%=styleStr%>"></i></span>
            <% } else { %>
            <span class="icon" style="<%=styleStr%>"></span>
            <% } %>
            <b style="<%=styleStr%>"><%= result.examinee.username %></b>
            </a>
            <% } else { %>
            <span class="icon"></span>
            <span lang="en">unknown</span>
            <span lang="es">desconocido</span>
            <% } %>
          </td>
          <td class="test-tables-text has-text-right" data-value="<%= result.updatedAt %>"><%= formatTimeAgo(result.updatedAt, lang) %></td>
          <% const minutes = Math.floor(result.nSeconds / 60); %>
          <% const seconds = Math.floor(result.nSeconds) % 60; %>
          <% const formattedTime = `${minutes ? minutes.toString()+"m" : ""} ${seconds.toString()}s`; %>
          <td class="test-tables-text has-text-right" data-value="<%= result.nSeconds %>"><%= formattedTime %></td>
          <% var correctPercentageVal = correctPercentage(result.score,result.nQuestions) %>
          <td class="test-tables-text has-text-right" data-value="<%= getWeigthedScore(result.nSeconds, result.nQuestions, result.score) %>">
            <b style="<%=styleStr%>"><%= result.score %>/<%= result.nQuestions %> (<%= correctPercentageVal %>%)</b>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="has-text-centered">
    <span lang="en">No results for this test yet.</span>
    <span lang="es">No hay resultados para este test aún.</span>
  </p>
  <% } %>
  <p class="has-text-centered is-size-7">
    <span class="icon"><i class="fas fa-exclamation-triangle"></i></span>
    <b lang="en">Only resuls posterior to latest test version and answering all questions are considered.</b>
    <b lang="es">Solo se consideran resultados posteriores a la última versión del test y que respondan a todas las preguntas.</b>
  </p>
</div>

<div id="tab-content-myTab" class="tab-content is-hidden">
  <% if (session.user) { %>
  <% if (test.userResults.length > 0) { %>
  <div class="table-container">
    <table class="table is-fullwidth is-hoverable is-striped">
      <thead>
        <tr>
          <th class="test-tables-header sortable descending" data-type="text"><span lang="en">User</span><span lang="es">Usuario</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
          <th class="test-tables-header has-text-right sortable descending" style="color: var(--link-color);" data-type="date"><span lang="en">Date</span><span lang="es">Fecha</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
          <th class="test-tables-header has-text-right sortable descending" data-type="number"><span lang="en">Duration</span><span lang="es">Duración</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
          <th class="test-tables-header has-text-right sortable descending" data-type="number"><span lang="en">Score</span><span lang="es">Puntuación</span> <span class="sort-icon"><i class="fas fa-angle-down"></i></span></th>
        </tr>
      </thead>
      <tbody>
        <% test.userResults.forEach(result => { %>
        <tr class="is-clickable" data-href="/results/<%= result.id %>">
          <td class="test-tables-text " data-value="<%= result.examinee.username %>">
            <a href="/users/<%= result.examinee.username %>">
              <span class="icon has-text-primary"><i class="fas fa-user-astronaut"></i></span>
              <span class="has-text-primary"><%= result.examinee.username %></span>
            </a>
          </td>
          <td class="test-tables-text has-text-right" data-value="<%= result.updatedAt %>"><%= formatTimeAgo(result.updatedAt, lang) %></td>
          <% const minutes = Math.floor(result.nSeconds / 60); %>
          <% const seconds = Math.floor(result.nSeconds) % 60; %>
          <% const formattedTime = `${minutes ? minutes.toString()+"m" : ""} ${seconds.toString()}s`; %>
          <td class="test-tables-text has-text-right" data-value="<%= result.nSeconds %>"><%= formattedTime %></td>
          <% var correctPercentageVal = correctPercentage(result.score,result.nQuestions) %>
          <td class="test-tables-text has-text-right" data-value="<%= getWeigthedScore(result.nSeconds, result.nQuestions, result.score) %>">
            <%= result.score %>/<%= result.nQuestions %> (<%= correctPercentageVal %>%)
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="has-text-centered">
    <span lang="en">You haven't tried this test yet.</span>
    <span lang="es">Aún no has intentado este test.</span>
  </p>
  <% } %>
  <% } else { %>
  <p class="has-text-centered">
    <span lang="en">Log in to see your results.</span>
    <span lang="es">Inicia sesión para ver tus resultados.</span>
  </p>
  <% } %>
</div>
