<!-- Set title and meta information -->
<script class="title-metadata-js" nonce="<%=nonce%>">
  document.title = "Live Battle Not Found | WiseSloth.open";

  // Change document meta description
  document.querySelector('meta[name="description"][lang="en"]').setAttribute("content", "Live Battle not found page for WiseSloth.open.");
  // document.querySelector('meta[name="description"][lang="es"]').setAttribute("content", "Página de Live Battle no encontrado para WiseSloth.open.");

  // Set as noindex
  if (metaRobots) metaRobots.setAttribute("content", "noindex");
</script>

<!-- Main content -->
<!-- Main content -->
<div class="hero is-light is-fullheight">
  <div class="hero-body">
    <div class="container has-text-centered">
      <div class="columns is-centered">
        <div class="column is-8">
          <!-- Title -->
          <p class="title is-1">
            <span lang="en">404 Not Found 😕</span>
            <span lang="es">404 Not Found 😕</span>
          </p>
          <!-- Subtitle -->
          <p class="subtitle is-3">
            <span lang="en">Live Battle [<%= liveBattleId %>] is ongoing, finished, or has expired...</span>
            <span lang="es">Live Battle [<%= liveBattleId %>] está en curso, finalizado o expirado...</span>
          </p>
          <!-- Suggestion -->
          <p class="is-size-5">
            <span lang="en">You can try with a different ID:</span>
            <span lang="es">Intenta con un ID diferente:</span>
          </p>
          <!-- Join Button -->
          <button class="button is-link is-rounded is-large open-modal-livebattle-button" title="Join a live battle">
            <span lang="en">Join Live Battle</span>
            <span lang="es">Join Live Battle</span>
            <span class="icon is-small"><i class="fas fa-bolt"></i></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
