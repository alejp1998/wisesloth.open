<% var isMe = session.user && session.user.username === user.username; %>
<% var isIFollow =  session.user && (session.user.iFollowUsernames || []).includes(user.username); %>
<% var isFollowsMe = session.user && (session.user.followMeUsernames || []).includes(user.username); %>

<div class="flex-card" id="card-user-<%=user.username%>">
  <div class="card user-card" data-user-username="<%=user.username%>">

    <!-- If the user has stats -->
    <% if (user.stats) {
      const total = user.stats.userHits + user.stats.userOmissions + user.stats.userFails;
      const hitsPerc = Math.round(user.stats.userHits / total * 100);
      const omissionsPerc = Math.round(user.stats.userOmissions / total * 100);
      const failsPerc = Math.round(user.stats.userFails / total * 100);
    %>
    <header class="card-header stats-border"
          style="--stats-green-end: <%=hitsPerc%>%; --stats-grey-end: <%=hitsPerc + omissionsPerc%>%;">
    <% } else { %>
    <header class="card-header">
    <% } %>
      <div class="card-header-title">
        <% if (user.isAdmin) { %><span class="icon is-large" title="Admin"><i class="fas fa-crown fa-lg"></i></span>
        <% } else { %><span class="icon is-large"><i class="fas fa-user fa-lg"></i></span><% } %>
        <% if (viewType === "INDEX") { %>
          <a class="user-username" href="/users/<%=user.username%>"><%=user.username%></a>
        <% } else { %>
          <p class="user-username"><%=user.username%></p>
        <% } %>
      </div>
      <div class="card-header-icon">
        <% if (user.stats) { %>
        <div class="stats user-stats">
          <!-- Include user charts -->
          <% var chartType = "user"; %>
          <% var chartId = user.id; %>
          <% var chartStats = user.stats; %>
          <%- include('../auxiliary/chart', { chartType, chartId, chartStats }) %>
        </div>
        <% } %>

        <% if(viewType === "SHOW") { %>
        <span id="card-hide-button-user-<%=user.username%>" class="icon is-large">
          <i class="fas fa-angle-up" aria-hidden="false"></i>
        </span>
        <% } else { %>
        <span id="card-hide-button-user-<%=user.username%>" class="icon is-large">
          <i class="fas fa-angle-down" aria-hidden="false"></i>
        </span>
        <% } %>
      </div>
    </header>
    <div class="card-content" id="card-content-<%=user.username%>">
      <% const tagSize = viewType === "INDEX" ? "is-medium" : "is-medium"; %>
      <% const tagSizeTopic = viewType === "INDEX" ? "is-small" : "is-medium"; %>
      <div class="content">
        <% if (viewType === "SHOW") { %>
        <div id="card-hidden-user-<%=user.username%>">
        <% } else { %>
        <div class="is-hidden" id="card-hidden-user-<%=user.username%>">
        <% } %>
          <p class="user-name is-size-5"><b><%=user.name%></b></p>
          <p class="user-desc is-size-5"><%=user.desc%></p>
          <br>
        </div>
        <div class="columns">
          <div class="column">
            <div class="field is-grouped is-grouped-multiline">
              <% if (user.publicAuthoredTestsCount && user.publicAuthoredTestsCount > 0) { %>
              <div class="control">
                <div class="tags has-addons">
                  <span class="tag <%=tagSize%> is-info" title="Number of authored tests">
                    <span class="icon is-small"><i class="fas fa-clipboard-list"></i></span><em><%=user.authoredTestsCount%></em>
                  </span>
                  <span class="tag <%=tagSize%> is-success" title="Number of authored tests that are public">
                    <span class="icon is-small"><i class="fas fa-globe-europe"></i></span><em><%=user.publicAuthoredTestsCount%></em>
                  </span>
                </div>
              </div>
              <% } else if (user.authoredTestsCount && user.authoredTestsCount > 0) { %>
              <div class="control">
                <div class="tags has-addons">
                  <span class="tag <%=tagSize%> is-info" title="Number of authored tests">
                    <span class="icon is-small"><i class="fas fa-clipboard-list"></i></span><em><%=user.authoredTestsCount%></em>
                  </span>
                  <span class="tag <%=tagSize%> is-success" title="Number of authored tests that are public">
                    <span class="icon is-small"><i class="fas fa-globe-europe"></i></span><em>0</em>
                  </span>
                </div>
              </div>
              <% } %>
              <% if (user.stats && user.stats.nTries > 0) { %>
              <span class="tag <%=tagSize%> is-warning" title="Number of test tries">
                <i class="fas fa-play-circle"></i> <em><%=user.stats.nTries%></em>
              </span>
              <span class="tag <%=tagSize%> is-success is-hidden-desktop" title="Number of correct answers">
                <i class="fas fa-check-circle"></i> <em><%=user.stats.userHits%></em>
              </span>
              <span class="tag <%=tagSize%> is-danger is-hidden-desktop" title="Number of incorrect answers">
                <i class="fas fa-times-circle"></i> <em><%=user.stats.userFails%></em>
              </span>
              <% if (user.stats.nSeconds > 0) { %>
              <span class="tag <%=tagSize%> is-dark" title="Total time spent taking tests">
                <!-- Include stopwatch -->
                <% var nSeconds = user.stats.nSeconds; %>
                <%- include('../auxiliary/stopwatch', {nSeconds, viewType}) %>
              </span>
              <% } %>
              <% } %>
            </div>
          </div>
          <div class="column is-narrow has-text-right">
            <% if (!isMe) { %>
              <% if (!session.user) { %>
              <p class="title is-6">
                <span lang="en">Log in to follow</span>
                <span lang="es">Inicia sesión para seguir</span>
              </p>
              <% } else if (isFollowsMe) { %>
              <p class="title is-6 has-text-success">
                <span lang="en">Follows you</span>
                <span lang="es">Te sigue</span>
              </p>
              <% } else { %>
              <p class="title is-6 has-text-danger">
                <span lang="en">Doesn't follow you</span>
                <span lang="es">No te sigue</span>
              </p>
              <% } %>
            <% } else { %>
              <p class="title is-6">
                <span lang="en">You</span>
                <span lang="es">Tú</span>
              </p>
            <% } %>
            <p class="subtitle is-6">
              <span class="icon"><i class="fas fa-calendar"></i></span>
              <span lang="en"><%= formatTimeAgo(user.createdAt, lang) %></span>
              <span lang="es"><%= formatTimeAgo(user.createdAt, lang) %></span>
            </p>
          </div>
        </div>
      </div>
    </div>
    <footer class="card-footer">

      <% if ((isMe || isAdmin) && viewType === "SHOW") { %>
      <div class="card-footer-item edit-user-button">
        <span class="icon"><i class="fas fa-edit"></i></span>
      </div>
      <% } %>
      <% if ((isAdmin) && viewType === "SHOW") { %>
      <% const deleteType = 'user'; %>
      <% const deleteMsg = "Delete " + user.username + "?"; %>
      <div class="card-footer-item delete-item-button" data-item-id="<%=user.username%>" data-delete-type="<%=deleteType%>" data-delete-msg="<%=deleteMsg%>">
        <span class="icon"><i class="fas fa-trash" style="color: var(--bulma-danger);"></i></span>
      </div>
      <% } %>
      <div class="card-footer-item share-user-button" data-user-username="<%=user.username%>">
        <span class="icon"><i class="fas fa-share-alt" style="color: var(--bulma-info);"></i></span>
      </div>
      <% if(session.user && !isMe) { %>
      <div class="card-footer-item follow-button" data-user-username="<%=user.username%>" data-is-followed="<%=isIFollow%>">
        <% if (isIFollow) { %>
        <span class="icon"><i class="fas fa-user-minus" style="color: var(--danger-color);"></i></i></span>
        <% } else { %>
        <span class="icon"><i class="fas fa-user-plus" style="color: var(--success-color);"></i></span>
        <% } %>
      </div>
      <% } %>
    </footer>
  </div>
</div>


<!-- Modal and script to edit user -->
<% if ((isMe || isAdmin) && viewType === "SHOW") { %>
<div id="modal-edit-user" class="modal">
  <div class="modal-background"></div>
  <div class="modal-card">
    <header class="modal-card-head">
      <% if (isMe) { %>
      <p class="modal-card-title">
        <span lang="en">Edit your profile</span>
        <span lang="es">Editar tu perfil</span>
      </p>
      <% } else { %>
      <p class="modal-card-title">
        <span lang="en">Edit user</span>
        <span lang="es">Editar usuario</span>
      </p>
      <% } %>
      <button class="modal-delete delete" aria-label="close"></button>
    </header>
    <section class="modal-card-body">
      <div class="modalUser" id="user-<%=user.username%>">
        <% if (isAdmin) { %>
        <label class="label" for="modalRole">
          <span lang="en">Role</span>
          <span lang="es">Rol</span>
        </label>
        <div class="control">
          <div class="select">
            <select id="modalUserRole">
              <option value="user" <% if (!user.isEditor && !user.isAdmin) { %>selected<% } %>>
                User
              </option>
              <option value="editor" <% if (user.isEditor) { %>selected<% } %>>
                Editor
              </option>
              <option value="admin" <% if (user.isAdmin) { %>selected<% } %>>
                Admin
              </option>
            </select>
          </div>
        </div>
        <% } %>
        <label class="label" for="modalUsername">
          <span lang="en">Username</span>
          <span lang="es">Nombre de usuario</span>
        </label>
        <div class="control">
          <input type="text" class="textarea" rows="1" id="modalUserUsername" value="<%=user.username%>" autocomplete="off"/>
        </div>
        <label class="label" for="modalName">
          <span lang="en">Name</span>
          <span lang="es">Nombre</span>
        </label>
        <div class="control">
          <input type="text" class="textarea" rows="1" id="modalUserName" value="<%=user.name%>" autocomplete="off"/>
        </div>
        <label class="label" for="modalDesc">
          <span lang="en">Description</span>
          <span lang="es">Descripción</span>
        </label>
        <div class="control">
          <input type="text" class="textarea" rows="1" id="modalUserDesc" value="<%=user.desc%>" autocomplete="off"/>
        </div>
      </div>
      <div class="modal-alert"></div>
    </section>
    <footer class="modal-card-foot">
      <div class="buttons">
        <button id="modal-edit-user-button" class="button is-primary">
          <span class="icon"><i class="fas fa-save"></i></span>
          <span lang="en">Save changes</span>
          <span lang="es">Guardar cambios</span>
        </button>
        <button class="modal-cancel button">
          <span class="icon"><i class="fas fa-times"></i></span>
          <span lang="en">Cancel</span>
          <span lang="es">Cancelar</span>
        </button>
      </div>
    </footer>
  </div>
</div>
<% } %>
