<!-- Set title -->
<script class="title-metadata-js" nonce="<%=nonce%>">
  document.title = "Results | WiseSloth.open";

  // Change document meta description
  document.querySelector('meta[name="description"][lang="en"]').setAttribute("content", "Results page for WiseSloth.open: navigate through your test results.");
  // document.querySelector('meta[name="description"][lang="es"]').setAttribute("content", "Página de resultados para WiseSloth.open: navega a través de tus resultados de tests.");

  // Set as index
  if (metaRobots) metaRobots.setAttribute("content", "index");
</script>

<!-- Include hero header -->
<% const heroTitleEn = "Navigate Results" %>
<% const heroTitleEs = "Navegar Resultados" %>
<% const heroSubtitleEn = "" %>
<% const heroSubtitleEs = "" %>
<% const containerId = "" %>
<%- include('../auxiliary/hero-header', { heroTitleEn, heroTitleEs, heroSubtitleEn, heroSubtitleEs, containerId }) %>

<!-- Results Content -->
<% const viewType = "INDEX" %>
<section id="usercontent" class="container">

  <nav class="level index-menu" id="results-index-menu">
    <!-- Left-side -->
    <div class="level-left">
      <div class="level-item">
        <% if (type === "following") { %>
        <p class="title is-3">
          <span lang="en">Results Feed</span>
          <span lang="es">Feed de Resultados</span>
        </p>
        <% } else { %>
          <% if (session.user && username === session.user.username) { %>
          <p class="title is-3">
            <span lang="en">My Results</span>
            <span lang="es">Mis Resultados</span>
          </p>
          <% } else { %>
          <p class="title is-3">
            <span lang="en">Results</span>
            <span lang="es">Resultados</span>
          </p>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- Controls -->
    <div class="level-right">
      <!-- Type dropdown: All, Mine, Following -->
      <div class="level-item">
        <div class="dropdown is-hoverable">
          <div class="dropdown-trigger">
            <div class="button" aria-haspopup="true" aria-controls="dropdown-menu">
              <% if (type === "following") { %>
              <span class="icon">
                <i class="fas fa-walking fa-flip-horizontal"></i>
                <i class="fas fa-walking fa-flip-horizontal" style="color: var(--link-color)"></i>
              </span>
              <span lang="en">Following</span>
              <span lang="es">Siguiendo</span>
              <% } else if (type === "mine" || (session.user && username === session.user.username)) { %>
              <span class="icon"><i class="fas fa-user-astronaut"></i></span>
              <span lang="en">Mine</span>
              <span lang="es">Míos</span>
              <% } else { %>
              <span class="icon"><i class="fas fa-users"></i></span>
              <span lang="en">All</span>
              <span lang="es">Todos</span>
              <% } %>
              <span class="icon is-small">
                <i class="fas fa-angle-down" aria-hidden="true"></i>
              </span>
            </div>
          </div>
          <div class="dropdown-menu" id="dropdown-menu" role="menu">
            <div class="dropdown-content">
              <div class="dropdown-item select-type-button" role="menuitem" data-type="all">
                <span class="icon"><i class="fas fa-users"></i></span>
                <span lang="en">All</span>
                <span lang="es">Todos</span>
              </div>
              <div class="dropdown-item select-type-button" role="menuitem" data-type="following">
                <span class="icon">
                  <i class="fas fa-walking fa-flip-horizontal"></i>
                  <i class="fas fa-walking fa-flip-horizontal" style="color: var(--link-color)"></i>
                </span>
                <span lang="en">Following</span>
                <span lang="es">Siguiendo</span>
              </div>
              <div class="dropdown-item select-type-button" role="menuitem" data-type="mine">
                <span class="icon"><i class="fas fa-user-astronaut"></i></span>
                <span lang="en">Mine</span>
                <span lang="es">Míos</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Search tags -->
  <div class="flex-container" style="margin-left: 10px; margin-right: 10px; margin-top: 10px; margin-bottom: 10px;" id="search-tags-container">
    <div class="field is-grouped is-grouped-multiline">
      <% if (username) { %>
      <div class="control">
        <div class="tags has-addons">
          <span class="tag is-medium is-link">
            <span class="icon"><i class="fas fa-user-astronaut"></i></span>
            <span lang="en">Examinee</span>
            <span lang="es">Examinado</span>
          </span>
          <span class="tag is-medium">
            <b><a href="/users/<%= username %>"><%= username %></a></b>
          </span>
          <button class="tag is-delete is-medium is-dark tag-delete-button" data-tag-name="username" aria-label="Delete tag"></button>
        </div>
      </div>
      <% } %>
    </div>
  </div>

  <div class="flex-container">
    <% if (Object.keys(groupedResults).length === 0) { %>
    <% if (type === "following") { %>
    <div class="notification">
      <p class="title is-4">
        <span lang="en">No results found from users you follow</span>
        <span lang="es">No se encontraron resultados de usuarios que sigues</span>
      </p>
      <p class="subtitle is-5">
        <span lang="en">Try following more users in the <a href="/users">users page</a></span>
        <span lang="es">Intenta seguir más usuarios en la <a href="/users">página de usuarios</a></span>
      </p>
    </div>
    <% } else { %>
    <div class="notification">
      <p class="title is-4">
        <span lang="en">No results found matching your search</span>
        <span lang="es">No se encontraron resultados que coincidan con tu búsqueda</span>
      </p>
      <p class="subtitle is-5">
        <span lang="en">Remove some filters or take quizzes to generate results</span>
        <span lang="es">Quita algunos filtros o intenta tests para generar resultados</span>
      </p>
    </div>
    <% } %>
    <% } else { %>
    <% for (const testId in groupedResults) { %>
    <% const groupedResult = groupedResults[testId] %>
    <!-- Include test card -->
    <%- include('../cards/grouped-result', { groupedResult }) %>
    <% } %>
    <% } %>
  </div>
</section>

<!-- Pagination -->
<div class="container">
  <div class="flex-container" id="pagination-container">
    <% if (paginateControl.html) { %>
    <%- paginateControl.html %>
    <% } %>
  </div>
</div>
