<!--
  New Test Creation Page
  Creates tests from: Old Exam, Notes/Text, Instructions (From Scratch), or Personality
-->

<!-- ========== PAGE METADATA ========== -->
<script class="title-metadata-js" nonce="<%=nonce%>">
  document.title = "New Test | WiseSloth.open: Create a Quiz or Test Effortlessly with AI";
  document.querySelector('meta[name="description"][lang="en"]')?.setAttribute("content",
    "Create a new quiz or test effortlessly with AI from an old exam, notes, text, or from scratch. Share with friends or students and compete in leaderboards."
  );
  if (metaRobots) metaRobots.setAttribute("content", "index");
</script>

<!-- ========== INITIALIZATION SCRIPT ========== -->
<!-- NOTE: no `id` on purpose - scripts without an id re-run on every AJAX navigation
     (handleCurrentState), which re-initializes FilePond/PDF uploads on the fresh DOM.
     With an id, loadedScripts dedupes it and the upload widgets never re-init after
     navigating away and back to /tests/new. -->
<script class="test-new-js" data-n="100" nonce="<%=nonce%>">
  // Load random facts from server
  if (randomFacts.length === 0) {
    randomFacts = <%- safeJson(randomFacts) %>;
  }

  // Initialize page (only if not already initialized)
  if (!isNewTestInitialized) {
    const initNewTestPage = () => {
      if (isTestNewJSLoaded) {
        addAllNewTestEventListeners();
        isNewTestInitialized = true;
      } else {
        setTimeout(initNewTestPage, 500);
      }
    };

    if (document.readyState === "complete") {
      initNewTestPage();
    } else {
      document.addEventListener("DOMContentLoaded", () => {
        addAllNewTestEventListeners();
        isNewTestInitialized = true;
      });
    }
  } else {
    addAllNewTestEventListeners();
  }
</script>

<!-- ========== EXTERNAL DEPENDENCIES ========== -->
<!-- FilePond -->
<script src="https://cdn.jsdelivr.net/npm/filepond@4.30.6/dist/filepond.min.js" class="test-new-js" id="filepond-js" data-n="2"></script>
<script src="https://cdn.jsdelivr.net/npm/filepond-plugin-file-validate-size@2.2.8/dist/filepond-plugin-file-validate-size.min.js" class="test-new-js" id="filepond-validate-size-js" data-n="3"></script>
<script src="https://cdn.jsdelivr.net/npm/filepond-plugin-file-validate-type@1.2.9/dist/filepond-plugin-file-validate-type.min.js" class="test-new-js" id="filepond-validate-type-js" data-n="4"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/filepond@4.30.6/dist/filepond.min.css" class="test-new-css" id="filepond-css">

<!-- PDF.js -->
<script src="/scripts/pdf-loader.js" class="test-new-js" id="pdf-js" data-n="5"></script>

