<script src="/scripts/user-skills.js?v=20260816-multi" class="test-new-js" id="user-skills-lib-js" data-n="8"></script>
<script class="user-skills-js" nonce="<%=nonce%>">
  // Re-inits the skills selector on every (AJAX) render of this page
  (function retrySkills() {
    if (!window.UserSkills) return setTimeout(retrySkills, 200);
    window.UserSkills.reload();
  })();
</script>
