        </div>
      </div>

      <!-- ==================== PERSONALITY TAB (Hidden) ==================== -->
      <div id="tab-content-personality" class="tab-content is-hidden" style="display: none;">
        <div id="personalityTest" class="box">

          <!-- Form Fields -->
          <div class="field is-horizontal">
            <div class="field-body">
              <!-- Language Select -->
              <div class="field">
                <label class="label" for="personality-language-select">
                  <span lang="en">Language</span>
                  <span lang="es">Idioma</span>
                </label>
                <div class="control">
                  <div class="select">
                    <select id="personality-language-select">
                      <% Object.entries(languagesDict).forEach(([code, language]) => { %>
                      <option value="<%= language.name %> (<%= code %>)" <%= code === lang ? 'selected' : '' %>><%= language.name %> (<%= code %>)</option>
                      <% }); %>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Number of Questions -->
              <div class="field">
                <label class="label" for="personality-questions-select">
                  <span lang="en">Questions</span>
                  <span lang="es">Preguntas</span>
                </label>
                <div class="control">
                  <div class="select">
                    <select id="personality-questions-select">
                      <% for (let j = 5; j <= 10; j++) { %>
                      <option value="<%= j %>" <%= j === 5 ? 'selected' : '' %>><%= j %></option>
                      <% } %>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Number of Personalities -->
              <div class="field">
                <label class="label" for="personality-options-select">
                  <span lang="en">Personalities</span>
                  <span lang="es">Personalidades</span>
                </label>
                <div class="control">
                  <div class="select">
                    <select id="personality-options-select">
                      <% for (let k = 2; k <= 6; k++) { %>
                      <option value="<%= k %>" <%= k === 3 ? 'selected' : '' %>><%= k %></option>
                      <% } %>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Instructions -->
          <div class="field">
            <label class="label">
              <span lang="en">Instructions</span>
              <span lang="es">Instrucciones</span>
            </label>
            <div class="control">
              <textarea class="textarea is-link" id="personality-instructions-input" autocomplete="off" rows="1"
                placeholder="<%= lang === 'en' ? 'Fun test to discover what character is more like me: Superman, Batman, Lex Luthor or The Joker' : 'Test divertido para descubrir qué personaje se parece más a mí: Superman, Batman, Lex Luthor o el Joker' %>"></textarea>
            </div>
            <p class="help is-hidden-touch">
              <span lang="en">Instructions about what you want the personality test to be about.</span>
              <span lang="es">Instrucciones sobre el tema del test de personalidad.</span>
            </p>
          </div>

          <br>

          <!-- Create Button -->
          <em id="result-container-personality" class="has-text-centered has-text-danger is-size-6"></em>
          <div class="create-row">
          <button type="button" class="creation-skills-btn creation-skills-chip"
                  data-defaults='<%= JSON.stringify(DEFAULT_SKILLS) %>'
                  data-logged-in="<%= session.user ? 'true' : 'false' %>"
                  title="Skills &amp; preferences for the current creation type">
            <i class="fas fa-sliders-h"></i>
            <span class="creation-skills-label">
              <span lang="en">Skills</span>
              <span lang="es">Skills</span>
            </span>
            <span class="skill-type-count skills-mini-count"></span>
          </button>
          <button id="personality-test-button" class="button is-medium is-link is-rounded is-fullwidth create-test-button" disabled data-can-create="<%= canCreate ? 'true' : 'false' %>">
            <span class="icon"><i class="fas fa-magic"></i></span>
            <span lang="en">Do the magic!</span>
            <span lang="es">¡Haz la magia!</span>
          </button>
          </div>
          <%- infoMsgHTML %>
        </div>
      </div>

      <!-- ==================== FLASHCARDS TAB ==================== -->
      <div id="tab-content-flashcards" class="tab-content is-hidden">
        <div id="flashcardsTest" class="box">

          <div class="columns is-variable is-4">
            <!-- Number of Cards (left) -->
            <div class="column is-4">
              <div class="field">
                <label class="label" for="flashcards-cards-select">
                  <span lang="en">Cards</span>
                  <span lang="es">Tarjetas</span>
                </label>
                <div class="control">
                  <div class="select">
                    <select id="flashcards-cards-select">
                      <% for (let j = 10; j <= 50; j += 5) { %>
                      <option value="<%= j %>" <%= j === 20 ? 'selected' : '' %>><%= j %></option>
                      <% } %>
                    </select>
                  </div>
                </div>
                <p class="help is-hidden-touch">
                  <span lang="en">Each card has a front (term/concept) and a back (definition/answer).</span>
                  <span lang="es">Cada tarjeta tiene un frente (término/concepto) y un reverso (definición/respuesta).</span>
                </p>
              </div>
            </div>

            <!-- Extra Guidelines (right of the card count) -->
            <div class="column">
              <div class="field">
                <label class="label">
                  <span lang="en">Extra Guidelines (Optional)</span>
                  <span lang="es">Instrucciones Adicionales (Opcional)</span>
                </label>
                <div class="control">
                  <textarea class="textarea" id="flashcards-instructions-input" autocomplete="off" rows="2"
                    placeholder="<%= lang === 'en' ? 'For medical students. Focus on definitions, not procedures.' : 'Para estudiantes de medicina. Céntrate en definiciones, no en procedimientos.' %>"></textarea>
                </div>
                <p class="help is-hidden-touch">
                  <span lang="en">Extra guidelines about the flashcards you want. The more details, the better.</span>
                  <span lang="es">Instrucciones adicionales sobre las tarjetas que quieres. Cuantos más detalles, mejor.</span>
                </p>
              </div>
            </div>
          </div>

          <!-- PDF/Text Tabs -->
          <div class="tabs is-medium is-centered">
            <ul>
              <li class="tab is-active" id="tab-toggle-flashcardsFromPDF">
                <a>
                  <span class="icon"><i class="fas fa-file-pdf"></i></span>
                  <span lang="en">From PDF</span>
                  <span lang="es">Desde PDF</span>
                </a>
              </li>
              <li class="tab" id="tab-toggle-flashcardsFromText">
                <a>
                  <span class="icon"><i class="fas fa-align-left"></i></span>
                  <span lang="en">From text</span>
                  <span lang="es">Desde texto</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- PDF Upload Section -->
          <div id="tab-content-flashcardsFromPDF" class="tab-content">
            <div class="field">
              <label class="label">
                <span lang="en">Content to make flashcards from</span>
                <span lang="es">Contenido para hacer tarjetas</span>
              </label>
              <input type="file" class="filepond" name="filepond" id="flashcards-file-input" data-max-files="1">
              <div id="flashcards-pdf-container" class="pdf-container is-hidden">
                <p lang="en" class="is-hidden-touch">Select and preview pages to process:</p>
                <p lang="es" class="is-hidden-touch">Selecciona y previsualiza las páginas a procesar:</p>
                <div id="flashcards-pdf-pages" class="pdf-pages"></div>
              </div>
            </div>
            <div class="field is-hidden" id="flashcards-extracted-text-field">
              <label class="label">
                <span lang="en">Text extracted from PDF</span>
                <span lang="es">Texto extraído del PDF</span>
              </label>
              <div class="control">
                <textarea class="textarea is-link" id="flashcards-extracted-text" autocomplete="off" rows="5" placeholder=""></textarea>
              </div>
              <div class="help is-hidden-touch is-size-7">
                <span lang="en">Will be used to generate the flashcards. If the text is not correct, you can edit it here.</span>
                <span lang="es">Se usará para generar las tarjetas. Si el texto no es correcto, puedes editarlo aquí.</span>
              </div>
            </div>
          </div>

          <!-- Text Input Section -->
          <div id="tab-content-flashcardsFromText" class="tab-content is-hidden">
            <div class="field">
              <label class="label">
                <span lang="en">Content to make flashcards from</span>
                <span lang="es">Contenido para hacer tarjetas</span>
              </label>
              <div class="control">
                <textarea class="textarea is-link" id="flashcards-content-input" autocomplete="off" rows="5"
                  placeholder="<%= lang === 'en' ? 'A cell is a ... it has a nucleus ...' : 'Una célula es un ... tiene un núcleo ...' %>"></textarea>
<div class="field mt-3"><label class="label" for="flashcards-source-url">Or import a web link</label><input class="input" id="flashcards-source-url" type="url" placeholder="https://example.com/article"><p class="help">Public HTML, Markdown or plain text; links can be combined with your notes.</p></div>
              </div>
              <p class="help is-hidden-touch">
                <span lang="en">Paste your notes or text content here.</span>
                <span lang="es">Pega tus apuntes o contenido de texto aquí.</span>
              </p>
            </div>
          </div>

          <br>

          <!-- Create Button -->
          <em id="result-container-flashcards" class="has-text-centered has-text-danger is-size-6"></em>
          <p class="is-size-7 has-text-link has-text-centered is-hidden-touch">
            <span lang="en"><b>Your files are safe!</b> They are processed entirely on your device and never sent to our servers.</span>
            <span lang="es"><b>¡Tus archivos están seguros!</b> Se procesan únicamente en tu dispositivo y nunca se envían a nuestros servidores.</span>
          </p>
          <div class="create-row">
          <button type="button" class="creation-skills-btn creation-skills-chip"
                  data-defaults='<%= JSON.stringify(DEFAULT_SKILLS) %>'
                  data-logged-in="<%= session.user ? 'true' : 'false' %>"
                  title="Skills &amp; preferences for the current creation type">
            <i class="fas fa-sliders-h"></i>
            <span class="creation-skills-label">
              <span lang="en">Skills</span>
              <span lang="es">Skills</span>
            </span>
            <span class="skill-type-count skills-mini-count"></span>
          </button>
          <button id="flashcards-test-button" class="button is-medium is-link is-rounded is-fullwidth create-test-button" disabled data-can-create="<%= canCreate ? 'true' : 'false' %>">
            <span class="icon"><i class="fas fa-magic"></i></span>
            <span lang="en">Do the magic!</span>
            <span lang="es">¡Haz la magia!</span>
          </button>
          </div>
          <%- infoMsgHTML %>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- ========== PROCESSING MODAL ========== -->
<div class="modal" id="processing-modal">
  <div class="non-closable-background"></div>
  <div class="modal-content" style="min-width: 50%;">
    <div class="box">
      <!-- Processing in progress -->
      <div id="processing-ongoing">
        <nav class="level is-mobile">
          <div class="level-left">
            <div class="level-item">
              <i class="fas fa-cog fa-2x fa-spin"></i>
            </div>
          </div>
          <div class="level-item">
            <div class="subtitle is-3" id="processing-message">
              <span lang="en">Processing...</span>
              <span lang="es">Procesando...</span>
            </div>
          </div>
          <div class="level-right">
            <div class="level-item">
              <div id="stopwatch-value" class="subtitle is-3">0s</div>
            </div>
          </div>
        </nav>

        <div class="subtitle is-5 has-text-centered" id="processing-fact"></div>

        <div class="title is-7 has-text-danger has-text-centered" id="processing-warning">
          <span lang="en">Do not close this tab until processing is done.</span>
          <span lang="es">No cierres esta pestaña hasta que termine el procesamiento.</span>
        </div>
        <br>
      </div>

      <!-- Processing successful -->
      <div id="processing-succesful" class="is-hidden">
        <div id="processing-succesful-title" class="subtitle is-4"></div>
        <div id="processing-succesful-stats"></div>
        <div id="processing-succesful-info">
          <div class="subtitle is-7 has-text-danger is-hidden-touch">
            <span lang="en">Once your tokens become negative, you won't be able to create new tests until reset.</span>
            <span lang="es">Una vez que tus tokens se vuelvan negativos, no podrás crear nuevos tests hasta que se restablezcan.</span>
          </div>
        </div>
        <div id="processing-succesful-test-card"></div>
        <div class="field is-grouped">
          <div id="processing-succesful-button-try" class="button is-primary is-medium is-fullwidth"></div>
          <div id="processing-succesful-button-view" class="button is-link is-medium is-fullwidth"></div>
          <div id="processing-succesful-button-edit" class="button is-warning is-medium is-fullwidth"></div>
        </div>
        <br>
      </div>

      <!-- Ad container (hidden for premium users) - TEMPORARILY DISABLED (ads deactivated).
           Re-enable by removing the comment markers below. -->

    </div>
  </div>
</div>

