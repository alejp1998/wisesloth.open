<!-- ===== JAVASCRIPT FOR ANIMATIONS (scroll reveal, counters, magnetic) =====
     Exposed as a re-runnable function so these effects also work when the home
     page is loaded via AJAX navigation (handleCurrentState re-executes this
     script). Guards make it idempotent per DOM element. -->
<script class="home-js" nonce="<%=nonce%>">
  window.initHomeAnimations = function () {
    // ===== ANIMATED NUMBER COUNTER =====
    const animateCounters = () => {
      const counters = document.querySelectorAll('.stat-animate');
      counters.forEach(counter => {
        const target = +counter.getAttribute('data-target');
        const duration = 2000;
        let start = 0;
        const step = (timestamp) => {
          if (!start) start = timestamp;
          const progress = timestamp - start;
          const current = Math.min(Math.floor((progress / duration) * target), target);
          counter.textContent = current.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
          if (current < target) {
            requestAnimationFrame(step);
          } else {
            counter.textContent = target.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
          }
        };
        requestAnimationFrame(step);
      });
    };

    // Check if animation has been shown in this session
    const hasAnimationBeenShown = sessionStorage.getItem('statsAnimationShown') === 'true';

    const statsBar = document.querySelector('.stats-bar');
    if (statsBar && !statsBar.dataset.observed) {
      statsBar.dataset.observed = '1';
      const counterObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (!hasAnimationBeenShown) {
              animateCounters();
              sessionStorage.setItem('statsAnimationShown', 'true');
            }
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.8 });
      counterObserver.observe(statsBar);
    }

    // ===== FADE-IN SECTIONS ON SCROLL (only observe fresh, unobserved sections) =====
    const fadeInSections = document.querySelectorAll('.fade-in-section:not([data-observed])');
    if (fadeInSections.length) {
      const sectionObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      fadeInSections.forEach(section => {
        section.setAttribute('data-observed', '1');
        sectionObserver.observe(section);
      });
    }

    // ===== MAGNETIC BUTTON EFFECT (bind once per element) =====
    const magneticButton = document.querySelector('.magnetic-btn');
    if (magneticButton && !magneticButton.dataset.magneticBound) {
      magneticButton.dataset.magneticBound = '1';
      magneticButton.addEventListener('mousemove', function(e) {
        const rect = this.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        this.style.transition = 'transform 0.1s linear';
        this.style.transform = `translate(${x / 20}px, ${y / 20}px)`;
      });
      magneticButton.addEventListener('mouseleave', function() {
        this.style.transition = 'transform 0.3s ease-out';
        this.style.transform = 'translate(0, 0)';
      });
    }

    // ===== FLASHCARD FLIP DEMO (bento grid) =====
    const flipDemo = document.getElementById('home-flip-demo');
    if (flipDemo && !flipDemo.dataset.bound) {
      flipDemo.dataset.bound = '1';
      const toggleFlip = () => flipDemo.classList.toggle('is-flipped');
      flipDemo.addEventListener('click', toggleFlip);
      flipDemo.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleFlip();
        }
      });
    }

    // ===== AI-EDIT TYPEWRITER DEMO (bento grid) =====
    const reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('.typewriter:not([data-bound])').forEach(function (el) {
      el.dataset.bound = '1';
      const text = el.dataset.text || '';
      if (reducedMotion || !text) {
        el.textContent = text;
        return;
      }
      let i = 0;
      let deleting = false;
      const tick = () => {
        el.textContent = text.slice(0, i);
        if (!deleting && i < text.length) {
          i++;
          setTimeout(tick, 45);
        } else if (!deleting) {
          deleting = true;
          setTimeout(tick, 1800);
        } else if (i > 0) {
          i--;
          setTimeout(tick, 20);
        } else {
          deleting = false;
          setTimeout(tick, 500);
        }
      };
      tick();
    });
  };

  // Run on full page load (and re-run on every AJAX render of the home page)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { window.initHomeAnimations(); });
  } else {
    window.initHomeAnimations();
  }
</script>
