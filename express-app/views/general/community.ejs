<script>
document.addEventListener('DOMContentLoaded', () => {
    // Setup tab switching for all tab groups
    document.querySelectorAll('[data-tab-group]').forEach(tabContainer => {
        const tabs = tabContainer.querySelectorAll('li');
        const contentContainer = tabContainer.nextElementSibling.parentElement;

        tabs.forEach(tab => {
            tab.addEventListener('click', e => {
                e.preventDefault();

                // Get the target content ID from the clicked tab's link
                const targetId = tab.querySelector('a').dataset.target;
                const targetContent = document.getElementById(targetId);

                // If the tab is already active or target doesn't exist, do nothing
                if (tab.classList.contains('is-active') || !targetContent) {
                    return;
                }

                // Deactivate all tabs in the current group
                tabs.forEach(t => t.classList.remove('is-active'));
                // Activate the clicked tab
                tab.classList.add('is-active');

                // Hide all tab content within the same section
                contentContainer.querySelectorAll('.tab-content-item').forEach(content => {
                    content.classList.add('is-hidden');
                });

                // Show the target content
                targetContent.classList.remove('is-hidden');
            });
        });
    });

    // Setup navigation for elements with a 'data-href' attribute
    document.querySelectorAll('[data-href]').forEach(element => {
        element.addEventListener('click', e => {
            // Prevent redirecting if a nested link or another data-href was the actual click target
            if (e.target.closest('a') || (e.target.closest('[data-href]') !== element)) {
                return;
            }
            window.location.href = element.dataset.href;
        });
    });
});
</script>
