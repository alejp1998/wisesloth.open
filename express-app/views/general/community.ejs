    <p class="title is-4">
      <i class="fas fa-crown"></i>
      <span lang="en">Top Users</span>
      <span lang="es">Top Usuarios</span>
    </p>

    <div class="tabs is-boxed is-medium is-centered">
      <ul>
        <li class="tab is-active" id="tab-toggle-usersByTests">
          <a title="Top Users by Public Quizzes" aria-label="Top Users by Public Quizzes">
            <span class="icon"><i class="fas fa-globe-europe has-text-success"></i></span>
            <span lang="en">By Public Quizzes</span>
            <span lang="es">Por Tests Públicos</span>
          </a>
        </li>
        <li class="tab" id="tab-toggle-usersByTries">
          <a title="Top Users by Tries" aria-label="Top Users by Tries">
            <span class="icon"><i class="fas fa-play"></i></span>
            <span lang="en">By Tries</span>
            <span lang="es">Por Intentos</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Top users by public tests created -->
    <!-- Show the user's username under username -->
    <!-- In the order 4th, 2nd, 1st, 3rd, 5th -->
    <!-- 4th and 5th have grey border and no medal -->
    <!-- 2nd and 3rd have silver and bronze medals respectively with same border color -->
    <!-- 1st has gold medal and gold border -->
    <div id="tab-content-usersByTests" class="tab-content">
      <div class="columns is-multiline">
        <% for (let i of indexes) { %>
          <% if (topUsersByPublicTests[i] === undefined) continue; %>
          <div class="column is-one-fifth-desktop <%= (i === 4) || (i === 3) ? 'is-hidden-touch' : '' %>">
            <div class="box is-clickable equal-height-as-sibling <%=borderColors[i]%>" data-href="/users/<%=topUsersByPublicTests[i].username%>" style="position: relative; padding-bottom: 40px;">
              <p class="is-size-4 has-text-centered">
                <% if (i === 0) { %>
                  <span class="icon is-large"><i class="fas fa-medal fa-2x" style="color: var(--gold-color);" title="1st Place"></i></span>
                <% } else if (i === 1) { %>
                  <span class="icon is-large"><i class="fas fa-medal fa-2x" style="color: var(--silver-color);" title="2nd Place"></i></span>
                <% } else if (i === 2) { %>
                  <span class="icon is-large"><i class="fas fa-medal fa-2x" style="color: var(--bronze-color);" title="3rd Place"></i></span>
