      <div class="columns is-multiline">
        <% for (let i of indexes) { %>
          <% if (topUsersByTries[i] === undefined) continue; %>
          <div class="column is-one-fifth-desktop <%= (i === 4) || (i === 3) ? 'is-hidden-touch' : '' %>">
            <div class="box is-clickable equal-height-as-sibling <%=borderColors[i]%>" data-href="/users/<%=topUsersByTries[i].username%>" style="position: relative; padding-bottom: 40px;">
              <p class="is-size-4 has-text-centered">
                <% if (i === 0) { %>
                  <span class="icon is-large"><i class="fas fa-medal fa-2x" style="color: var(--gold-color);" title="1st Place"></i></span>
                <% } else if (i === 1) { %>
                  <span class="icon is-large"><i class="fas fa-medal fa-2x" style="color: var(--silver-color);" title="2nd Place"></i></span>
                <% } else if (i === 2) { %>
