<!-- Set title -->
<script class="title-metadata-js" nonce="<%=nonce%>">
  document.title = "Community | WiseSloth.open";
</script>

<!-- Showcase number of tests created, tried, and number of users three column boxes -->
<% const indexes = [3, 1, 0, 2, 4]; %>
<% const borderColors = ['golden', 'silver', 'bronze', 'fourth-fifth', 'fourth-fifth']; %>
<section class="section">
  <div class="container has-text-centered">
    <p class="title is-2">
      <span class="icon is-large"><i class="fas fa-users"></i></span>
      <span lang="en">Our Community</span>
      <span lang="es">Nuestra Comunidad</span>
    </p>
    <p class="subtitle is-5 is-hidden-touch">
      <span lang="en">&#128080; Join our growing community of learners and educators, and start generating quizzes with AI today!</span>
      <span lang="es">&#128080; ¡Únete a nuestra creciente comunidad de estudiantes y educadores, y comienza a generar tests con IA hoy!</span>
    </p>
  </div>
  <br>
  <div class="container has-text-centered">
    <div class="columns community-stats-grid">
      <div class="column">
        <% if (isLoggedIn) { %>
        <div class="box equal-height-as-sibling selected is-clickable" data-href="/users">
        <% } else { %>
        <div class="box equal-height-as-sibling selected">
        <% } %>
          <p class="title is-2">
            <span class="icon"><i class="fas fa-user-astronaut"></i></span>
            <span lang="en"><%=nUsers%></span>
            <span lang="es"><%=nUsers%></span>
          </p>
          <p class="subtitle is-4">
            <span lang="en">Users</span>
            <span lang="es">Usuarios</span>
          </p>
        </div>
      </div>
      <div class="column">
        <div class="box equal-height-as-sibling marked" data-href="/tests">
          <p class="title is-2">
            <span class="icon"><i class="fas fa-question-circle"></i></span>
            <span lang="en"><%=nQuizQuestionsCreated%></span>
            <span lang="es"><%=nQuizQuestionsCreated%></span>
          </p>
          <p class="subtitle is-4">
            <span lang="en">Questions</span>
            <span lang="es">Preguntas</span>
          </p>
        </div>
      </div>
      <div class="column">
        <div class="box is-clickable equal-height-as-sibling marked" data-href="/tests">
          <p class="title is-2">
            <span class="icon"><i class="fas fa-clipboard-list"></i></span>
            <span lang="en"><%=nTestsCreated%></span>
            <span lang="es"><%=nTestsCreated%></span>
          </p>
          <p class="subtitle is-4">
            <span lang="en">Quizzes</span>
            <span lang="es">Tests</span>
          </p>
        </div>
      </div>
      <div class="column">
        <div class="box equal-height-as-sibling omitted" data-href="/results">
          <p class="title is-2">
            <span class="icon"><i class="fas fa-check-double"></i></span>
            <span lang="en"><%=nQuizQuestionsAnswered%></span>
            <span lang="es"><%=nQuizQuestionsAnswered%></span>
          </p>
          <p class="subtitle is-4">
            <span lang="en">Answers</span>
            <span lang="es">Respuestas</span>
          </p>
        </div>
      </div>
      <div class="column">
        <% if (isLoggedIn) { %>
        <div class="box equal-height-as-sibling omitted is-clickable" data-href="/results">
        <% } else { %>
        <div class="box equal-height-as-sibling omitted">
        <% } %>
          <p class="title is-2">
            <span class="icon"><i class="fas fa-trophy"></i></span>
            <span lang="en"><%=nTestsTried%></span>
            <span lang="es"><%=nTestsTried%></span>
          </p>
          <p class="subtitle is-4">
            <span lang="en">Results</span>
            <span lang="es">Resultados</span>
          </p>
        </div>
      </div>
    </div>
  </div>
  <br>
  <br>
  <br>

  <!-- Showcase top users by : public tests created, tries -->
