              <p class="title is-5 has-text-centered">
                <%=topUsersByPublicTests[i].username%>
              </p>
              <div class="bottom-center-pos">
                <p class="title is-4 has-text-centered">
                  <span class="icon"><i class="fas fa-globe-europe has-text-success" title="Public Quizzes Created"></i></span>
                  <span lang="en"><%=topUsersByPublicTests[i].nPublicTests%></span>
                  <span lang="es"><%=topUsersByPublicTests[i].nPublicTests%></span>
