              </div>
            </div>
          </div>
        <% } %>
      </div>
      <!-- Add a button to see the full ranking -->
      <div class="has-text-centered">
        <a href="/users?orderby=public&orderdir=desc" class="button is-success is-light is-medium">
          <span class="icon"><i class="fas fa-list-ol"></i></span>
          <span lang="en">See Full Ranking</span>
          <span lang="es">Ver Clasificación Completa</span>
        </a>
