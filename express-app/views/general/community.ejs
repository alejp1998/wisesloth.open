                <% } else if (i === 3) { %>
                  <b class="icon is-large has-text-grey-light">4th</b>
                <% } else if (i === 4) { %>
                  <b class="icon is-large has-text-grey-light">5th</b>
                <% } %>
              </p>
              <p class="title is-5 has-text-centered">
                <%=topUsersByTries[i].username%>
              </p>
              <div class="bottom-center-pos">
                <p class="title is-4 has-text-centered">
                  <span class="icon"><i class="fas fa-play" title="Tries"></i></span>
                  <span lang="en"><%=topUsersByTries[i].nTries%></span>
                  <span lang="es"><%=topUsersByTries[i].nTries%></span>
                </p>
              </div>
            </div>
          </div>
        <% } %>
      </div>
      <!-- Add a button to see the full ranking -->
