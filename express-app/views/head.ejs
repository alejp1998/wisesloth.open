<head>
  <%
    // Defaults shared by every page, can be overridden per-route via pageTitle/pageDescription/pageImage locals
    const defaultPageTitle = "WiseSloth.open: quizzes on your own server";
    const defaultPageDescription = "WiseSloth.open: Quickly create AI quizzes from exams, notes, or any text in any language. Shuffle questions, track progress, share with friends, compete in real time, and climb the leaderboards!";
    const resolvedTitle = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : defaultPageTitle;
    const resolvedDescription = (typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : defaultPageDescription;
    const resolvedImage = (typeof pageImage !== 'undefined' && pageImage) ? pageImage : appUrl + "/images/sloth-logo.webp";
    const currentPath = (typeof url !== 'undefined' && url) ? url.split('?')[0] : "/";
    const canonicalUrl = appUrl + currentPath;
  %>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="referrer" content="no-referrer-when-downgrade">
  <meta name="robots" content="index, follow">
  <meta name="format-detection" content="telephone=no">
  <meta name="description" lang="en" content="<%= resolvedDescription %>">
  <title><%= resolvedTitle %></title>

  <!-- Apply the saved theme BEFORE the stylesheets load, so there is no white
       flash on full page reloads (the visitor's localStorage preference wins) -->
  <script nonce="<%=nonce%>">
    (function () {
      try {
        var savedTheme = localStorage.getItem('bulma-theme');
        if (savedTheme === 'dark' || savedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', savedTheme);
        }
      } catch (e) {}
    })();
  </script>

  <!-- Canonical URL -->
  <link rel="canonical" href="<%= canonicalUrl %>">

  <!-- Open Graph / Facebook, Discord, WhatsApp, Slack, iMessage link previews -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="WiseSloth.open">
  <meta property="og:title" content="<%= resolvedTitle %>">
  <meta property="og:description" content="<%= resolvedDescription %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:image" content="<%= resolvedImage %>">
  <meta property="og:image:width" content="512">
  <meta property="og:image:height" content="512">
  <meta property="og:locale" content="<%= lang === 'es' ? 'es_ES' : 'en_US' %>">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= resolvedTitle %>">
  <meta name="twitter:description" content="<%= resolvedDescription %>">
  <meta name="twitter:image" content="<%= resolvedImage %>">

  <!-- Organization / WebSite structured data for Google Knowledge Graph -->
  <script type="application/ld+json" nonce="<%=nonce%>">
  <%- safeJson({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "WiseSloth.open",
    "url": appUrl + "/",
    "description": defaultPageDescription,
    "publisher": {
      "@type": "Organization",
      "name": "WiseSloth.open",
      "logo": appUrl + "/images/sloth-logo.webp"
    }
  }) %>
  </script>

  <!-- CMP by iubenda ? -->

  <!-- Favicon -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="<%= theme === 'dark' ? '#1a1a1a' : '#ffffff' %>">

  <!-- Resource hints: speed up connections to third-party origins used below -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Preload DM Sans (renders hero text) + Jura (titles) to avoid font-swap CLS on first paint -->
  <link rel="preload" as="font" type="font/woff2" crossorigin href="https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxRSW32.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="https://fonts.gstatic.com/s/jura/v34/z7NOdRfiaC4Vd8hhoPzfb5vBTP266pumR_g.woff2">
  <!-- <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com"> -->

<!-- Critical CSS (above-fold: nav, hero, cookie banner) inlined to cut render-blocking -->
