  <script id="MathJax-script" type="text/javascript" nonce="<%=nonce%>"></script>
  <% } %>

  <!-- Marked.js for Markdown rendering -->
  <script defer src="https://cdn.jsdelivr.net/npm/marked@18.1.1/lib/marked.umd.js"></script>

  <script defer src="https://cdn.jsdelivr.net/npm/dompurify@3.4.17/dist/purify.min.js"></script>

  <!-- Raleway font import -->
  <!-- <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Raleway" /> -->

  <!-- DM Sans + Jura + Space Grotesk fonts: inlined @font-face (no render-blocking stylesheet request) -->
  <style id="fonts-inline">
@font-face {
  font-family: 'DM Sans';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxRSW32.woff2) format('woff2');
}
@font-face {
  font-family: 'Jura';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/jura/v34/z7NOdRfiaC4Vd8hhoPzfb5vBTP266pumR_g.woff2) format('woff2');
}
@font-face {
  font-family: 'Space Grotesk';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url(https://fonts.gstatic.com/s/spacegrotesk/v22/V8mQoQDjQSkFtoMM3T6r8E7mF71Q-gOoraIAEj4PVnskPMA.woff2) format('woff2');
}
  </style>

  <!-- DM Sans font style -->
  <!-- This sets the fonts to user in the body in order of preference -->
  <style>
    body {
      font-family: "DM Sans", sans-serif;
      font-size: 16px;
    }
  </style>

  <!-- Set light or dark theme and local language -->
  <script nonce="<%=nonce%>">
  // Local theme variable
  let localTheme;
  // Respect the visitor's saved theme (already applied early in <head>)
  // NOTE: name prefixed with ws_ to avoid clashing with other top-level scripts
  const wsStoredTheme = (function () { try { return localStorage.getItem('bulma-theme'); } catch (e) { return null; } })();
  if (wsStoredTheme === "dark" || wsStoredTheme === "light") {
    localTheme = wsStoredTheme;
    document.documentElement.setAttribute("data-theme", wsStoredTheme);
  } else {
  <% if (theme === "light") { %>
  localTheme = "light";
  document.documentElement.setAttribute("data-theme", localTheme);
  <% } else if (theme === "dark") { %>
  localTheme = "dark";
  document.documentElement.setAttribute("data-theme", localTheme);
  <% } %>
  }

  // Local lang variable
  let localLang;
  <% if (lang === "en") { %>
  localLang = "en";
  <% } else if (lang === "es") { %>
  localLang = "es";
  <% } %>
  </script>

</head>
